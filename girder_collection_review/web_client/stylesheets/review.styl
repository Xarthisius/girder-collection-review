.g-review-page
  max-width 520px
  margin 0 auto
  padding 48px 20px

  &.g-review-page-wide
    max-width none
    padding 0

.g-review-card
  padding 28px 32px 32px
  border 1px solid #ddd
  border-radius 4px
  background-color #fff

.g-review-card-title
  margin-top 0
  font-size 22px

.g-review-card-help
  color #666

.g-review-notice
  padding 8px 12px
  margin-bottom 16px
  border-radius 3px
  background-color #eef4fb
  border 1px solid #c5d9ee

.g-review-warning
  padding 8px 12px
  margin-bottom 16px
  border-radius 3px
  background-color #fcf6e3
  border 1px solid #e6d9a8

.g-review-error
  min-height 20px
  margin-bottom 8px
  color #a94442

.g-review-submit
  width 100%

.g-review-banner
  display flex
  align-items center
  justify-content space-between
  padding 10px 18px
  background-color #333
  color #eee

.g-review-banner-label
  display inline-block
  padding 1px 7px
  margin-right 10px
  border-radius 3px
  font-size 11px
  text-transform uppercase
  letter-spacing 0.06em
  background-color #6c6

.g-review-banner-name
  font-size 16px
  font-weight bold

.g-review-banner-exit
  color #ccc

  &:hover
    color #fff

  &:focus
    color #fff

.g-review-body
  padding 16px 24px 32px

.g-review-item
  .g-review-back-to-hierarchy
    display inline-block
    margin-bottom 12px

.g-review-item-description
  margin-bottom 16px
  color #666

.g-review-new-key
  padding 12px 14px
  margin-bottom 20px
  border-radius 3px
  background-color #f4faf4
  border 1px solid #cfe3cf

  h5
    margin-top 0

.g-review-new-key-help
  color #666

.g-review-new-key-url
  margin-top 8px
  margin-bottom 0
  color #666

.g-review-open-form
  margin-bottom 20px

.g-review-list-title
  margin-bottom 8px

.g-review-empty
  color #888

.g-review-table
  .g-review-row-closed
    color #999

  .g-review-actions-cell
    text-align right
